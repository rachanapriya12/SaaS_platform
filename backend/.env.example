PORT=4000
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-use-a-different-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Comma-separated browser origins. Leave unset or use * so the API reflects the request Origin (works with any Vercel URL without redeploying).
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string. Use MongoDB Atlas (free tier) or a local mongod.
# Examples:
#   mongodb://127.0.0.1:27017/collabdocs
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/collabdocs?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/collabdocs
